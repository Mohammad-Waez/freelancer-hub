// FreelanceHub - NestJS + Prisma + PostgreSQL
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DeliveryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  HOLD
  RELEASE
  COMMISSION
  REFUND
}

// ---------------------------------------------------------------
// Models
// ---------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile  FreelancerProfile?
  wallet   Wallet?
  projects Project[]          @relation("ProjectOwner")
  offers   Offer[]
    refreshTokens RefreshToken[]
}

model FreelancerProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoPath  String?
  bio        String?  @db.Text
  hourlyRate Decimal? @db.Decimal(12, 2)
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

model Project {
  id             Int           @id @default(autoincrement())
  ownerId        Int
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId     Int
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  description    String        @db.Text
  budget         Decimal       @db.Decimal(12, 2)
  attachmentPath String?
  status         ProjectStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  // set when an offer is accepted: acceptance time + the offer duration
  // (extended when the client asks for a revision)
  dueAt          DateTime?
  offers       Offer[]
  deliveries   Delivery[]
  transactions Transaction[]

  @@index([status, categoryId, createdAt])
  @@index([status, budget])
  @@index([ownerId])
}

model Offer {
  id           Int         @id @default(autoincrement())
  projectId    Int
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId Int
  freelancer   User        @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  price        Decimal     @db.Decimal(12, 2)
  durationDays Int
  message      String      @db.Text
  status       OfferStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  // one offer per freelancer per project
  @@unique([projectId, freelancerId])
  @@index([freelancerId])
}

model Wallet {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  // available balance only; CHECK (balance >= 0) is added in constraints.sql
  balance Decimal @default(0) @db.Decimal(12, 2)

  transactions Transaction[]
}

model Transaction {
  id        Int             @id @default(autoincrement())
  walletId  Int
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  projectId Int?
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type      TransactionType
  // signed: negative for money leaving the wallet (HOLD), positive for money entering it
  amount    Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([projectId])
}

model Delivery {
  id         Int            @id @default(autoincrement())
  projectId  Int
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  filePath   String
  status     DeliveryStatus @default(PENDING)
  clientNote String?        @db.Text
  // createdAt starts the 7-day auto-approval clock
  createdAt  DateTime       @default(now())

  @@index([projectId])
  @@index([status, createdAt])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}